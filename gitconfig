# ~/.gitconfig
# global git config

# core
[core]
    # set neovim as editor
    editor = nvim
    # preserve exec file-perm
    fileMode = true

# init
[init]
    # set default branch to main
    defaultBranch = main

# working directory for remote projects
[includeif "gitdir:~/projects/remote/"]
    path = ~/projects/remote/.gitconfig

# working directory for local projects
[includeif "gitdir:~/projects/local/"]
    path = ~/projects/local/.gitconfig
